APP_ENV=development
HTTP_ADDR=:8080
MYSQL_DSN=ai_meeting:ai_meeting@tcp(127.0.0.1:3306)/ai_meeting_go?charset=utf8mb4&parseTime=True&loc=Local&multiStatements=true
# Optional Compose-only override. Leave empty to use mysql:3306 inside Docker.
DOCKER_MYSQL_DSN=
REDIS_ADDR=127.0.0.1:6379
# Optional Compose-only override. Leave empty to use redis:6379 inside Docker.
DOCKER_REDIS_ADDR=
REDIS_PASSWORD=
JWT_SECRET=replace-with-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
FILE_STORAGE_PATH=./data/uploads
MAX_RESUME_BYTES=10485760
LLM_MODE=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
XINGCHEN_BASE_URL=https://xingchen-api.xf-yun.com
XINGCHEN_QUESTION_API_KEY=
XINGCHEN_QUESTION_API_SECRET=
XINGCHEN_QUESTION_FLOW_ID=
XINGCHEN_EVALUATION_API_KEY=
XINGCHEN_EVALUATION_API_SECRET=
XINGCHEN_EVALUATION_FLOW_ID=
XINGCHEN_ASKING_API_KEY=
XINGCHEN_ASKING_API_SECRET=
XINGCHEN_ASKING_FLOW_ID=
